# Copy this file to .env and fill in real values for your lab environment.
# Never commit the real .env file.

# UI base URL for the Insurance Order Entry demo application
BASE_URL=http://localhost:8083

# API base URL — usually the same host, sometimes a separate API gateway
API_BASE_URL=http://localhost:8083

# Seeded agent accounts (Section 3.1 user types).
# Replace with the actual credentials distributed for your cohort.
VALID_AGENT_EMAIL=agent.valid@insurance.test
VALID_AGENT_PASSWORD=ChangeMe123!

NEW_AGENT_EMAIL=agent.new@insurance.test
NEW_AGENT_PASSWORD=ChangeMe123!

LOCKED_AGENT_EMAIL=agent.locked@insurance.test
LOCKED_AGENT_PASSWORD=ChangeMe123!

MFA_AGENT_EMAIL=agent.mfa@insurance.test
MFA_AGENT_PASSWORD=ChangeMe123!

ADMIN_EMAIL=admin@insurance.test
ADMIN_PASSWORD=ChangeMe123!

# API key/token if the platform issues a static demo key (mirrors FinServe's
# X-API-Key pattern) — leave blank if the API only uses session/JWT auth.
API_KEY=
